{
  "name": "ponie-tools",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true next build --webpack",
